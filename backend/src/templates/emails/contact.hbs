<html lang="es">
  <body
    style="margin:0;padding:24px;background:#F7F7F2;font-family:Arial,Helvetica,sans-serif;color:#263B1C;"
  >
    <table
      role="presentation"
      width="100%"
      cellpadding="0"
      cellspacing="0"
      style="max-width:600px;margin:0 auto;background:#ffffff;border-radius:12px;"
    >
      <tr>
        <td style="padding:28px;">
          <h1 style="margin:0 0 4px;font-size:22px;">Nuevo mensaje de contacto</h1>
          <p style="margin:0 0 20px;color:#65913C;font-weight:bold;">Orso Tenis</p>

          <table
            role="presentation"
            cellpadding="0"
            cellspacing="0"
            style="font-size:15px;"
          >
            <tr><td style="padding:4px 16px 4px 0;color:#666;">Nombre</td><td
              ><strong>{{name}}</strong></td></tr>
            <tr><td style="padding:4px 16px 4px 0;color:#666;">Correo</td><td
              ><strong>{{email}}</strong></td></tr>
            <tr><td style="padding:4px 16px 4px 0;color:#666;">Asunto</td><td
              ><strong>{{subject}}</strong></td></tr>
            <tr><td style="padding:4px 16px 4px 0;color:#666;">Fecha</td><td
              >{{sentAt}}</td></tr>
          </table>

          <hr style="border:0;border-top:1px solid #e5e7e0;margin:20px 0;" />

          <p
            style="margin:0;font-size:15px;line-height:1.6;white-space:pre-wrap;"
          >{{message}}</p>

          <p style="margin:24px 0 0;font-size:12px;color:#888;">
            Podés responder directamente a este correo para contestarle a
            {{name}}.
          </p>
        </td>
      </tr>
    </table>
  </body>
</html>