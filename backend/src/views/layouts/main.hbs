<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{title}} | Orso Tenis</title>
  <style>
    :root { --verde-oscuro: #263B1C; --verde: #65913C; --fondo: #F7F7F2; --borde: #d9ddd3; }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
           background: var(--fondo); color: var(--verde-oscuro); line-height: 1.5; }
    main { max-width: 640px; margin: 0 auto; padding: 40px 16px; }
    .card { background: #fff; border-radius: 16px; padding: 28px; box-shadow: 0 1px 3px rgba(0,0,0,.08); }
    h1 { margin: 0 0 4px; font-size: 1.6rem; }
    .club { margin: 0 0 20px; color: var(--verde); font-weight: 600; }
    dl { display: grid; grid-template-columns: 140px 1fr; gap: 10px 16px; margin: 20px 0; }
    dt { color: #666; }
    dd { margin: 0; font-weight: 600; }
    .estado { display: inline-block; padding: 2px 12px; border-radius: 999px; font-size: .85rem; font-weight: 600; }
    .estado.ok { background: #dcfce7; color: #166534; }
    .estado.cancelada { background: #f3f4f6; color: #4b5563; }
    .acciones { display: flex; gap: 12px; margin-top: 24px; }
    button, .boton { font: inherit; font-weight: 600; padding: 10px 20px; border-radius: 8px; border: 0;
                     background: var(--verde-oscuro); color: #fff; cursor: pointer; text-decoration: none; }
    .boton.secundario { background: #fff; color: var(--verde-oscuro); border: 1px solid var(--borde); }
    footer { text-align: center; color: #777; font-size: .85rem; padding: 0 16px 32px; }
    @media print { .acciones, footer { display: none; } body { background: #fff; } .card { box-shadow: none; } }
  </style>
</head>
<body>
  <main>
    {{{body}}}
  </main>
  {{> footer}}
</body>
</html>
